diff --git a/.github/actions/setup-dependencies/action.yml b/.github/actions/setup-dependencies/action.yml
--- a/.github/actions/setup-dependencies/action.yml
+++ b/.github/actions/setup-dependencies/action.yml
@@ -122,9 +122,17 @@ runs:
+    - name: Limit aqt extraction concurrency on Windows
+      if: ${{ runner.os == 'Windows' }}
+      shell: pwsh
+      run: |
+        Set-Content -Path "$env:RUNNER_TEMP\aqt.ini" -Value "[aqt]`nconcurrency: 1"
+        "AQT_CONFIG=$env:RUNNER_TEMP\aqt.ini" >> $env:GITHUB_ENV
+
     - name: Install Qt
       uses: jurplel/install-qt-action@v4
       with:
         version: ${{ inputs.qt-version }}
         setup-python: false
         aqtsource: git+https://github.com/miurahr/aqtinstall.git@16db45a70b5905ad596941b223469bc86a56901e
+        extra: ${{ runner.os == 'Windows' && '--external 7z' || '' }}
         modules: qtimageformats qtnetworkauth
         cache: ${{ inputs.build-type == 'Debug' }}
         arch: ${{ inputs.msystem != '' && 'win64_llvm_mingw' || '' }}
